# AthenAI Lead Engine - example environment file
# Copy to `.env` and adjust. This project runs ONLY on synthetic data and
# contains NO real secrets. Do not put real API keys, CRM credentials or
# personally identifiable information here.

# Directory where per-tenant SQLite stores, CRM mocks and outbox files live.
# Relative paths are resolved from the repository root.
ATHENAI_DATA_DIR=./data

# Registered tenants (comma separated tenant_id list).
ATHENAI_TENANTS=tenant_alpha,tenant_beta

# AI/LLM provider selection.
# `mock` runs a deterministic offline provider. No real network/keys are used.
ATHENAI_LLM_PROVIDER=mock
# If a real provider is ever wired up, its key would go here. Leave EMPTY.
ATHENAI_LLM_API_KEY=

# Minimum AI confidence required to even consider an auto-approve path.
ATHENAI_AI_CONFIDENCE_THRESHOLD=0.75

# Integration resilience (deep module) tuning.
ATHENAI_MAX_ATTEMPTS=5
ATHENAI_BASE_BACKOFF_SECONDS=0.5
ATHENAI_MAX_BACKOFF_SECONDS=30

# Mock CRM fault profile for demos/tests:
# none | flaky_429 | flaky_5xx | always_500 | non_retryable_405
ATHENAI_CRM_ERROR_PROFILE=none

# HTTP API (mock webhook + metrics) bind address for local use only.
ATHENAI_HOST=127.0.0.1
ATHENAI_PORT=8000
